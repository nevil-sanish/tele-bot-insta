# --- Required ---
DATABASE_URL=              # Neon: Dashboard → Connect → connection string (postgresql://…?sslmode=require)
INSTAGRAM_APP_SECRET=      # Meta app → Instagram → API setup with Instagram login → Instagram app secret
INSTAGRAM_VERIFY_TOKEN=    # any random string; type the same one into Meta's webhook form
INSTAGRAM_ACCESS_TOKEN=    # same page → Generate access tokens (bot account); refreshed automatically
GEMINI_API_KEY=            # aistudio.google.com/apikey
GROQ_API_KEY=              # console.groq.com/keys
APIFY_TOKEN=               # console.apify.com/settings/integrations

# --- Optional ---
ADMIN_IG_IDS=              # comma-separated IGSIDs with the unlimited plan (logged as "new Instagram user <ID>")
PUBLIC_URL=                # set automatically on Render (RENDER_EXTERNAL_URL)

# --- Android app login (needed once the app exists) ---
APP_SECRET=                # any long random string; signs app session tokens
GOOGLE_CLIENT_IDS=         # comma-separated OAuth client IDs (Android + web) from Google Cloud Console

# --- Credits (defaults shown; 1 reel = UNITS_PER_REEL) ---
# UNITS_PER_REEL=10
# UNITS_PER_QUESTION=1
# UNITS_PER_FETCH=3
# FREE_UNITS=20

# --- Scaling (see README → Scaling) ---
# GEMINI_API_KEYS=key1,key2      # key pools; rotated, rate-limited keys rest
# GROQ_API_KEYS=key1,key2
# APIFY_TOKENS=token1,token2
# ROLE=all                       # web | worker when running separate services
# WORKER_CONCURRENCY=4
# ANALYZE_CONCURRENCY=4
# APIFY_BATCH=10                 # reels per Apify run

# --- Tuning (defaults shown) ---
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# GROQ_CHAT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# APIFY_ACTOR=apify~instagram-scraper
# ACTIVE_REEL_MINUTES=30         # how long plain questions go to the last reel
# GRAPH_API_URL=https://graph.instagram.com/v25.0
